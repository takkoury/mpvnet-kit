<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <AssemblyName>KitContextMenu</AssemblyName>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="mpvnet" HintPath="$(HostReferenceDirectory)/mpvnet.dll" Private="false" />
    <Reference Include="libmpvnet" HintPath="$(HostReferenceDirectory)/libmpvnet.dll" Private="false" />
  </ItemGroup>
  <Target Name="RequireHostReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(HostReferenceDirectory)' == '' Or !Exists('$(HostReferenceDirectory)/mpvnet.dll') Or !Exists('$(HostReferenceDirectory)/libmpvnet.dll')"
           Text="Set HostReferenceDirectory to the directory containing the supported mpvnet.dll and libmpvnet.dll build references." />
  </Target>
</Project>
