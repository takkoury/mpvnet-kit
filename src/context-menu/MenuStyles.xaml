<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:KitContextMenu">
  <local:LongHeaderTooltip x:Key="LongHeaderTooltip" />
  <Style x:Key="OwnScrollBar" TargetType="ScrollBar">
    <Setter Property="Width" Value="9" />
    <Setter Property="Background" Value="#151515" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
            <Track.DecreaseRepeatButton>
              <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False">
                <RepeatButton.Template>
                  <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                  </ControlTemplate>
                </RepeatButton.Template>
              </RepeatButton>
            </Track.DecreaseRepeatButton>
            <Track.Thumb>
              <Thumb MinHeight="24">
                <Thumb.Template>
                  <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbBody" Background="#707070" CornerRadius="3" Margin="2,1" />
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="ThumbBody" Property="Background" Value="#1287BB" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Thumb.Template>
              </Thumb>
            </Track.Thumb>
            <Track.IncreaseRepeatButton>
              <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False">
                <RepeatButton.Template>
                  <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                  </ControlTemplate>
                </RepeatButton.Template>
              </RepeatButton>
            </Track.IncreaseRepeatButton>
          </Track>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="MenuChrome" TargetType="ContextMenu">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Background" Value="#151515" />
    <Setter Property="Foreground" Value="#E5E5E5" />
    <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Width" Value="176" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border Background="{TemplateBinding Background}" BorderBrush="#3B3B3B" BorderThickness="1" CornerRadius="6" Padding="4">
            <ScrollViewer CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" MaxHeight="{DynamicResource KitMenuScrollHeight}">
              <ScrollViewer.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource OwnScrollBar}" />
              </ScrollViewer.Resources>
              <ItemsPresenter Grid.IsSharedSizeScope="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
            </ScrollViewer>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="MenuItem">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Foreground" Value="#E5E5E5" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Height" Value="32" />
    <Setter Property="ToolTip" Value="{Binding Header, RelativeSource={RelativeSource Self}, Converter={StaticResource LongHeaderTooltip}}" />
    <Setter Property="ToolTipService.InitialShowDelay" Value="550" />
    <Setter Property="ToolTipService.ShowDuration" Value="5000" />
    <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Grid>
            <Border x:Name="Row" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
              <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" MinWidth="10" />
                  <ColumnDefinition Width="Auto" SharedSizeGroup="Gesture" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid x:Name="CheckSpace" Width="14" Margin="0,0,6,0" Visibility="Collapsed">
                  <Ellipse x:Name="RadioMark" Width="5" Height="5" Fill="#1287BB" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <Path x:Name="CheckMark" Data="M1,5 L4,8 L11,1" Stroke="#1287BB" StrokeThickness="1.6" StrokeLineJoin="Round" Visibility="Collapsed" VerticalAlignment="Center" />
                </Grid>
                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" Margin="0,0,10,0" MaxWidth="340">
                  <ContentPresenter.Resources>
                    <Style TargetType="AccessText">
                      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                    </Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                    </Style>
                  </ContentPresenter.Resources>
                </ContentPresenter>
                <TextBlock x:Name="Gesture" Grid.Column="2" Text="{TemplateBinding InputGestureText}" MaxWidth="160" TextTrimming="CharacterEllipsis" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="9,0,0,0" FontSize="12" />
                <Path x:Name="Arrow" Grid.Column="3" Data="M1,1 L5,5 L1,9" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="6" Height="10" Margin="12,0,0,0" Visibility="Collapsed" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <Popup x:Name="PART_Popup" IsOpen="{Binding IsSubmenuOpen,RelativeSource={RelativeSource TemplatedParent}}" Placement="Right" HorizontalOffset="2" VerticalOffset="-5" AllowsTransparency="True" Focusable="False" PopupAnimation="None">
              <Border Background="#151515" BorderBrush="#3B3B3B" BorderThickness="1" CornerRadius="6" Padding="4" MinWidth="160" MaxWidth="560">
                <ScrollViewer CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" MaxHeight="{DynamicResource KitMenuScrollHeight}">
                  <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource OwnScrollBar}" />
                  </ScrollViewer.Resources>
                  <ItemsPresenter Grid.IsSharedSizeScope="True" KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="HasItems" Value="True">
              <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="">
              <Setter TargetName="Gesture" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Row" Property="Background" Value="#252525" />
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
              <Setter TargetName="Row" Property="Background" Value="#152B35" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Row" Property="BorderBrush" Value="#777777" />
            </Trigger>
            <Trigger Property="local:MenuMarks.ShowMark" Value="True">
              <Setter TargetName="CheckSpace" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsCheckable" Value="True">
              <Setter TargetName="CheckSpace" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="CheckSpace" Property="Visibility" Value="Visible" />
              <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="local:MenuMarks.IsMarked" Value="True">
              <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsChecked" Value="True" />
                <Condition Property="local:MenuMarks.IsRadio" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="CheckMark" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="RadioMark" Property="Visibility" Value="Visible" />
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="local:MenuMarks.IsMarked" Value="True" />
                <Condition Property="local:MenuMarks.IsRadio" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="CheckMark" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="RadioMark" Property="Visibility" Value="Visible" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="#888888" />
              <Setter TargetName="Gesture" Property="Foreground" Value="#777777" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ToolTip">
    <Setter Property="Foreground" Value="#E5E5E5" />
    <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="MaxWidth" Value="480" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="#242424" BorderBrush="#444444" BorderThickness="1" CornerRadius="4" Padding="9,7">
            <ContentPresenter ContentSource="Content">
              <ContentPresenter.Resources>
                <Style TargetType="TextBlock">
                  <Setter Property="TextWrapping" Value="Wrap" />
                </Style>
              </ContentPresenter.Resources>
            </ContentPresenter>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Border Height="1" Background="#353535" Margin="8,5" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="Separator" BasedOn="{StaticResource {x:Static MenuItem.SeparatorStyleKey}}" />
</ResourceDictionary>
